@model Kaluz.Web.Models.ChangePasswordForm
<h1>Cambiar contraseña</h1><form method="post" class="panel narrow">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="validation"></div><label>Contraseña actual<input type="password" asp-for="Actual" required/></label><label>Nueva contraseña<input type="password" asp-for="Nueva" minlength="8" required/></label><button class="btn">Guardar</button></form>