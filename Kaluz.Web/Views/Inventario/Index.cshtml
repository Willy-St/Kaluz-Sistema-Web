@{ViewData["Title"]="Inventario";}<h1>Inventario y movimientos</h1><div class="panel tablewrap"><h2>Existencias actuales</h2><table><thead><tr><th>Variante</th><th>Producto</th><th>Talla</th><th>Color</th><th>SKU</th><th>Stock</th><th>Mínimo</th></tr></thead><tbody>@foreach(var r in (List<Dictionary<string,object?>>)ViewBag.Items){<tr><td>@r["IdVariante"]</td><td>@r["Nombre"]</td><td>@r["Talla"]</td><td>@r["Color"]</td><td>@r["SKU"]</td><td><span class="@(Convert.ToInt32(r["StockActual"])<=Convert.ToInt32(r["StockMinimo"])?"warn":"")">@r["StockActual"]</span></td><td>@r["StockMinimo"]</td></tr>}</tbody></table></div>@if(User.IsInRole("Administrador")){<div class="panel"><h2>Ajuste manual de stock</h2><form method="post" action="/Inventario/Ajustar" class="filters">@Html.AntiForgeryToken()<input name="VarianteId" type="number" min="1" placeholder="ID variante" required/><input name="Diferencia" type="number" placeholder="+ entrada / - salida" required/><input name="Motivo" placeholder="Motivo" required/><button class="btn">Aplicar ajuste</button></form></div>}<div class="panel tablewrap"><h2>Historial de movimientos</h2><table><thead><tr><th>Fecha</th><th>Prenda</th><th>SKU</th><th>Tipo</th><th>Cantidad</th><th>Stock final</th><th>Motivo</th></tr></thead><tbody>@foreach(var r in (List<Dictionary<string,object?>>)ViewBag.History){<tr>@foreach(var k in new[]{"Fecha","Nombre","SKU","Tipo","Cantidad","StockResultante","Motivo"}){<td>@r[k]</td>}</tr>}</tbody></table></div>