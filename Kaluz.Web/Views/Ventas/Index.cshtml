@{ViewData["Title"]="Ventas";}<div class="pagehead"><h1>Ventas y tickets</h1><a class="btn" href="/Ventas/Crear">+ Registrar venta</a></div><div class="panel tablewrap"><table><thead><tr><th>Ticket</th><th>Fecha</th><th>Atendió</th><th>Total</th><th>Pago</th><th>Estado</th><th>Acción</th></tr></thead><tbody>@foreach(var r in (List<Dictionary<string,object?>>)ViewBag.Rows){<tr><td><a href="/Ventas/Ticket/@r["IdVenta"]">@r["NumeroTicket"]</a></td><td>@r["Fecha"]</td><td>@r["NombreCompleto"]</td><td>S/ @r["Total"]</td><td>@r["Metodo"]</td><td>@r["Estado"]</td><td>@if(User.IsInRole("Administrador")&&Convert.ToString(r["Estado"])=="Completada"){<form method="post" action="/Ventas/Anular/@r["IdVenta"]" onsubmit="return confirm('¿Anular venta y devolver stock?')">@Html.AntiForgeryToken()<button class="linkbtn">Anular</button></form>}</td></tr>}</tbody></table></div>