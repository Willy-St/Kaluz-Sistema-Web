@{var v=(Dictionary<string,object?>)ViewBag.Head;ViewData["Title"]="Ticket";}<div class="pagehead"><h1>Ticket @v["NumeroTicket"]</h1><button class="btn" onclick="window.print()">Imprimir ticket</button></div><div class="panel receipt"><h2>✦ Kaluz</h2><p>Fecha: @v["Fecha"]<br/>Atendió: @v["Vendedora"]<br/>Cliente: @v["Cliente"]<br/>Pago: @v["Pago"]<br/>Estado: @v["Estado"]</p><table><thead><tr><th>Prenda</th><th>Cant.</th><th>Precio</th><th>Importe</th></tr></thead><tbody>@foreach(var d in (List<Dictionary<string,object?>>)ViewBag.Items){<tr><td>@d["Nombre"] (@d["Talla"], @d["Color"])</td><td>@d["Cantidad"]</td><td>@d["PrecioUnitario"]</td><td>@d["Subtotal"]</td></tr>}</tbody></table><p>Subtotal: S/ @v["Subtotal"]<br/>Descuento: S/ @v["Descuento"]</p><h2>Total: S/ @v["Total"]</h2></div>