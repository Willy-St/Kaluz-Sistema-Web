@{ViewData["Title"]="Nueva venta";var items=(List<Dictionary<string,object?>>)ViewBag.Items;var clients=(List<Dictionary<string,object?>>)ViewBag.Clientes;var methods=(List<Dictionary<string,object?>>)ViewBag.Metodos;}<div class="pagehead"><h1>Registrar venta</h1><a href="/Ventas" class="btn secondary">Volver</a></div><div class="panel"><p>Para vender es obligatorio tener una caja abierta. El stock y el movimiento de caja se registrarán juntos.</p><form method="post">@Html.AntiForgeryToken()<div class="formgrid"><label>Cliente (opcional)<select name="ClienteId"><option value="">Cliente sin registrar</option>@foreach(var x in clients){<option value="@x["IdCliente"]">@x["Nombre"]</option>}</select></label><label>Método de pago<select name="MetodoPagoId" required>@foreach(var m in methods){<option value="@m["IdMetodoPago"]">@m["Nombre"]</option>}</select></label><label>Descuento S/<input type="number" name="Descuento" min="0" step="0.01" value="0"/></label></div><h2>Detalle de venta</h2><div id="saleLines"><div class="line"><select name="Lineas[0].VarianteId" required>@foreach(var x in items){<option value="@x["IdVariante"]">@x["Nombre"] — S/ @x["PrecioVenta"] — Stock @x["StockActual"]</option>}</select><input name="Lineas[0].Cantidad" type="number" min="1" value="1" required/></div></div><button type="button" class="btn secondary" id="addLine">+ Agregar prenda</button><p><button class="btn">Confirmar y cobrar</button></p></form></div><script>const opts=document.querySelector('#saleLines select').innerHTML;let n=1;document.querySelector('#addLine').onclick=()=>{let el=document.createElement('div');el.className='line';el.innerHTML='<select name="Lineas['+n+'].VarianteId">'+opts+'</select><input type="number" min="1" value="1" name="Lineas['+n+'].Cantidad" required/><button type="button" class="btn secondary" onclick="this.parentElement.remove()">Quitar</button>';document.querySelector('#saleLines').appendChild(el);n++;};</script><script>document.querySelector('form[method="post"]').addEventListener('submit',()=>{document.querySelectorAll('#saleLines .line').forEach((el,i)=>{el.querySelectorAll('[name^="Lineas["]').forEach(inp=>{inp.name=inp.name.replace(/Lineas\[\d+\]/,'Lineas['+i+']');});});});</script>