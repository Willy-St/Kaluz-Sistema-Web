@{ViewData["Title"]="Compras";}<div class="pagehead"><h1>Proveedores y compras</h1><a class="btn" href="/Compras/Crear">+ Nueva compra</a></div><div class="panel tablewrap"><table><thead><tr><th>ID</th><th>Proveedor</th><th>Fecha</th><th>Documento</th><th>Importe</th><th>Estado</th><th>Recibir</th></tr></thead><tbody>@foreach(var r in (List<Dictionary<string,object?>>)ViewBag.Rows){<tr><td>@r["IdCompra"]</td><td>@r["Proveedor"]</td><td>@r["Fecha"]</td><td>@r["NumeroDocumento"]</td><td>S/ @r["Total"]</td><td>@r["Estado"]</td><td><a href="/Compras/Detalle/@r["IdCompra"]">Ver detalles</a></td></tr>}</tbody></table></div>