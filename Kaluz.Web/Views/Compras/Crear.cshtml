@{ViewData["Title"]="Registrar compra";var items=(List<Dictionary<string,object?>>)ViewBag.Variantes;}<h1>Registrar compra a proveedor</h1><div class="panel"><p>La compra queda pendiente hasta registrar la cantidad efectivamente recibida.</p><form method="post">@Html.AntiForgeryToken()<div class="formgrid"><label>Proveedor<select name="ProveedorId" required>@foreach(var x in (List<Dictionary<string,object?>>)ViewBag.Proveedores){<option value="@x["IdProveedor"]">@x["Nombre"]</option>}</select></label><label>Número de documento<input name="Documento" maxlength="30"/></label></div><div id="lines"><div class="line"><select name="Lineas[0].VarianteId">@foreach(var x in items){<option value="@x["IdVariante"]">@x["Nombre"]</option>}</select><input type="number" name="Lineas[0].Cantidad" min="1" value="1" required/><input type="number" name="Lineas[0].Costo" min="0" step="0.01" placeholder="Costo unitario" required/></div></div><button type="button" id="add" class="btn secondary">+ Otra variante</button><p><button class="btn">Registrar compra</button></p></form></div><script>let n=1;let opts=document.querySelector('#lines select').innerHTML;document.querySelector('#add').onclick=()=>{let div=document.createElement('div');div.className='line';div.innerHTML='<select name="Lineas['+n+'].VarianteId">'+opts+'</select><input name="Lineas['+n+'].Cantidad" type="number" min="1" value="1" required/><input name="Lineas['+n+'].Costo" type="number" min="0" step="0.01" placeholder="Costo" required/><button type="button" class="btn secondary" onclick="this.parentElement.remove()">Quitar</button>';document.querySelector('#lines').appendChild(div);n++;}</script><script>document.querySelector('form[method="post"]').addEventListener('submit',()=>{document.querySelectorAll('#lines .line').forEach((el,i)=>{el.querySelectorAll('[name^="Lineas["]').forEach(inp=>{inp.name=inp.name.replace(/Lineas\[\d+\]/,'Lineas['+i+']');});});});</script>