@{var c=(Dictionary<string,object?>)ViewBag.Purchase;ViewData["Title"]="Recepción de compra";}<h1>Compra #@c["IdCompra"]</h1><p>Proveedor: @c["Proveedor"] | Estado: @c["Estado"] | Total: S/ @c["Total"]</p><div class="panel tablewrap"><table><thead><tr><th>Prenda</th><th>SKU</th><th>Solicitado</th><th>Recibido</th><th>Faltante</th><th>Recepción</th></tr></thead><tbody>@foreach(var d in (List<Dictionary<string,object?>>)ViewBag.Items){var missing=Convert.ToInt32(d["Cantidad"])-Convert.ToInt32(d["CantidadRecibida"]);<tr><td>@d["Nombre"]</td><td>@d["SKU"]</td><td>@d["Cantidad"]</td><td>@d["CantidadRecibida"]</td><td>@missing</td><td>@if(missing>0){<form method="post" action="/Compras/Recibir">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@c["IdCompra"]"/><input type="hidden" name="detalle" value="@d["IdDetalleCompra"]"/><input type="number" name="cantidad" min="1" max="@missing" value="@missing" required/><button class="btn">Recibir</button></form>}</td></tr>}</tbody></table></div>