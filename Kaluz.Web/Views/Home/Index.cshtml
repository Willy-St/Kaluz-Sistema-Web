@{ViewData["Title"]="Dashboard";}<div class="pagehead"><div><p class="eyebrow">RESUMEN GENERAL</p><h1>Buen día, @User.Identity?.Name</h1><p>Actividad de tu tienda en un solo lugar.</p></div><a class="btn" href="/Ventas/Crear">+ Nueva venta</a></div>@if(ViewBag.Error!=null){<div class="alert bad">@ViewBag.Error</div>}<div class="metrics"><div class="metric"><small>Ventas últimos 30 días</small><strong>S/ @ViewBag.Ventas</strong></div><div class="metric"><small>Productos activos</small><strong>@ViewBag.Productos</strong></div><div class="metric"><small>Variantes bajo mínimo</small><strong>@ViewBag.Bajos</strong></div><div class="metric"><small>Clientes activos</small><strong>@ViewBag.Clientes</strong></div></div><div class="panel"><h2>Ventas recientes</h2><table><thead><tr><th>Ticket</th><th>Fecha</th><th>Total</th><th>Estado</th></tr></thead><tbody>@foreach(var r in (List<Dictionary<string,object?>>)ViewBag.Recientes){<tr><td>@r["NumeroTicket"]</td><td>@r["Fecha"]</td><td>S/ @r["Total"]</td><td>@r["Estado"]</td></tr>}</tbody></table></div>