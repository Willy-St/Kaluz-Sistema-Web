@{var e=(EntityDef)ViewBag.Entity;var tipo=(string)ViewBag.Tipo;var d=(Dictionary<string,object?>)ViewBag.Data;var opciones=(Dictionary<string,List<Dictionary<string,object?>>>)ViewBag.Opciones;bool editing=d.ContainsKey(e.Key);ViewData["Title"]=(editing?"Editar ":"Nuevo ")+e.Caption;}<div class="pagehead"><h1>@ViewData["Title"]</h1><a class="btn secondary" href="/Maestros?tipo=@tipo">Volver</a></div><form method="post" class="panel narrow" action="/Maestros/Edit?tipo=@tipo&id=@(editing?d[e.Key]:0)">@Html.AntiForgeryToken()<div class="formgrid">@foreach(var f in e.Fields){var val=editing?Convert.ToString(d.GetValueOrDefault(f.Name)):null;<label>@f.Label @if(f.Required){<em>*</em>}@if(opciones.TryGetValue(f.Name,out var opts)){<select name="@f.Name" required><option value="">Seleccione @f.Label</option>@foreach(var op in opts){<option value="@op["Id"]" selected="@(editing && Convert.ToString(op["Id"])==val)">@op["Nombre"]</option>}</select>}else if(f.Type=="bool"){<select name="@f.Name"><option value="true" selected="@(val=="True"||!editing)">Sí</option><option value="false" selected="@(val=="False")">No</option></select>}else{<input type="@(f.Type=="decimal"?"number":f.Type)" name="@f.Name" value="@(f.Type=="decimal"?val?.Replace(',','.'):val)" step="@(f.Type=="decimal"?"0.01":"1")" required="@f.Required"/>}</label>}@if(tipo=="Usuarios"&&!editing){<label>Contraseña temporal (mínimo 8 caracteres)<input type="password" name="Password" minlength="8" required/></label>}</div><button class="btn">Guardar cambios</button></form>