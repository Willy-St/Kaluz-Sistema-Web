@{var e=(EntityDef)ViewBag.Entity;var tipo=(string)ViewBag.Tipo;ViewData["Title"]=e.Caption;var rows=(List<Dictionary<string,object?>>)ViewBag.Rows;}<div class="pagehead"><div><p class="eyebrow">MANTENIMIENTO</p><h1>@e.Caption</h1><p>Registra y actualiza la información de la tienda.</p></div><a class="btn" href="/Maestros/Edit?tipo=@tipo">+ Nuevo registro</a></div><form method="get" class="filters"><input type="hidden" name="tipo" value="@tipo"/><input name="q" placeholder="Buscar..." value="@ViewBag.Query"/><button class="btn secondary">Buscar</button></form><div class="panel tablewrap"><table><thead><tr><th>ID</th>@foreach(var f in e.Fields.Take(6)){<th>@f.Label</th>}<th>Acción</th></tr></thead><tbody>@foreach(var row in rows){<tr><td>@row[e.Key]</td>@foreach(var f in e.Fields.Take(6)){<td>@(f.Name=="Activo"?(Convert.ToBoolean(row[f.Name])?"Activo":"Inactivo"):row[f.Name])</td>}<td><a class="textlink" href="/Maestros/Edit?tipo=@tipo&id=@row[e.Key]">Editar</a>@if(e.Fields.Any(x=>x.Name=="Activo")&&Convert.ToBoolean(row["Activo"])){<form method="post" action="/Maestros/Disable?tipo=@tipo&id=@row[e.Key]" class="inline" onsubmit="return confirm('¿Desactivar registro?')">@Html.AntiForgeryToken()<button class="linkbtn">Desactivar</button></form>}</td></tr>}</tbody></table>@if(rows.Count==0){<p>No hay registros para mostrar.</p>}</div>